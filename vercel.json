{
  "version": 2,
  "functions": {
    "api/proxy.js": {
      "maxDuration": 15
    },
    "api/create-agent.js": {
      "maxDuration": 30
    },
    "api/checkout.js": {
      "maxDuration": 10
    },
    "api/webhook.js": {
      "maxDuration": 30
    },
    "api/reconcile-demo-tags.js": {
      "maxDuration": 60
    },
    "api/heartbeat.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reconcile-demo-tags",
      "schedule": "7 * * * *"
    }
  ]
}