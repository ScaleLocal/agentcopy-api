# AgentCopyAI API — Environment Variables
# Add these in Vercel Dashboard → Settings → Environment Variables

FIRECRAWL_API_KEY=fc-xxxxxxxx
GOOGLE_PLACES_API_KEY=AIzaSyxxxxxxxxxx
GHL_TOKEN=pit-xxxxxxxx
GHL_LOCATION_ID=xxxxxxxx
GHL_VOICE_AGENT_ID=xxxxxxxx
GHL_CHAT_BOT_ID=xxxxxxxx
ALLOWED_ORIGIN=https://agentcopyai.com

# Stripe webhook signing secret (Stripe Dashboard > Developers > Webhooks > [endpoint] > Signing secret)
# REQUIRED for /api/webhook to accept events. If unset, every Stripe event returns 400 and no provisioning runs.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback PIT for the AgentCopyAI sub-account voice agent edits (used by create-agent.js when GHL_TOKEN can't reach voice endpoints)
GHL_VOICE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Agency-level PIT used by webhook.js to auto-create per-customer sub-accounts.
# Get from GHL Agency view → Settings → Private Integrations → create one with
# scopes: locations.write, locations.readonly, snapshots.readonly, users.write.
GHL_AGENCY_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your GHL agency's company ID. Find in any /locations/search?companyId=... call,
# or in URL when you're in agency view. For ScaleLocal: FG7sbUjVDjTL90y9LnEP.
GHL_COMPANY_ID=FG7sbUjVDjTL90y9LnEP

# Snapshot ID of the "AgentCopyAI Customer Template" — created MANUALLY by Matt
# from the Master Templates sub-account (5WXkwbJv4EjlfL72BOHB) via GHL Agency
# Snapshots UI. Without this set, provisionCustomer no-ops and welcome email
# falls back to a placeholder snippet (manual install required).
GHL_TEMPLATE_SNAPSHOT_ID=

# URL of the AgentCopyAI Install booking calendar (15-min slots, max 1/hour).
# Created manually in the AgentCopyAI sub-account, then paste its public URL here.
# Falls back to scalelocal.net/install-help if unset.
INSTALL_BOOKING_URL=https://api.leadconnectorhq.com/widget/booking/xxxxxxxx
